{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "error"
  },
  "ignorePatterns": [
    "node_modules/**"
  ],
  "overrides": [
    {
      "files": [
        "scripts/**/*.ts"
      ],
      "rules": {
        "typescript/consistent-type-imports": "error",
        "typescript/no-explicit-any": "error",
        "typescript/no-non-null-assertion": "error",
        "prefer-const": "error",
        "no-var": "error",
        "eqeqeq": "error",
        "curly": "error",
        "typescript/no-floating-promises": [
          "error",
          {
            "ignoreVoid": false
          }
        ],
        "typescript/no-misused-promises": "error",
        "typescript/await-thenable": "error",
        "typescript/no-unsafe-assignment": "error",
        "typescript/no-unsafe-call": "error",
        "typescript/no-unsafe-member-access": "error",
        "typescript/no-unsafe-argument": "error",
        "typescript/no-unsafe-return": "error"
      }
    },
    {
      "files": [
        "scripts/tests/**",
        "tests/**"
      ],
      "rules": {
        "no-restricted-properties": [
          "error",
          {
            "property": "only",
            "message": "Keep all agreed tests active. Propose exclusions through an Issue and reviewed PR."
          },
          {
            "property": "skip",
            "message": "Keep all agreed tests active. Propose exclusions through an Issue and reviewed PR."
          },
          {
            "property": "todo",
            "message": "Keep all agreed tests active. Propose exclusions through an Issue and reviewed PR."
          },
          {
            "property": "skipIf",
            "message": "Keep all agreed tests active. Propose exclusions through an Issue and reviewed PR."
          },
          {
            "property": "runIf",
            "message": "Keep all agreed tests active. Propose exclusions through an Issue and reviewed PR."
          },
          {
            "property": "fixme",
            "message": "Keep all agreed tests active. Propose exclusions through an Issue and reviewed PR."
          }
        ],
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "bun:test",
                "importNames": [
                  "fit",
                  "fdescribe",
                  "xit",
                  "xtest",
                  "xdescribe"
                ],
                "message": "Use test/it/describe without selection or exclusion."
              },
              {
                "name": "@playwright/test",
                "importNames": [
                  "fit",
                  "fdescribe",
                  "xit",
                  "xtest",
                  "xdescribe"
                ],
                "message": "Use test/it/describe without selection or exclusion."
              }
            ]
          }
        ],
        "no-restricted-globals": [
          "error",
          "fit",
          "fdescribe",
          "xit",
          "xtest",
          "xdescribe"
        ]
      }
    }
  ],
  "options": {
    "typeAware": true
  }
}
